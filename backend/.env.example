PORT=4000
NODE_ENV=development

# MongoDB connection string. The database name in the path is the one used.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/levitron

# Optional override for the database name. Defaults to the name in the URI.
MONGO_DB=

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Drafting model (optional).
# Leave AI_API_KEY empty and Levitron uses its built-in draft engine instead,
# so the whole create -> export pipeline works with no external calls at all.
#
# Any OpenAI-compatible endpoint works. Groq example:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
#
# Check which models your key can actually reach before setting AI_MODEL —
# names change often, and an unavailable one silently falls back to the
# built-in engine:
#   node --env-file=.env -e "fetch(process.env.AI_BASE_URL+'/models',{headers:{Authorization:'Bearer '+process.env.AI_API_KEY}}).then(r=>r.json()).then(d=>console.log(d.data.map(m=>m.id).join('\n')))"
# ---------------------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Comma separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
