PORT=4000
NODE_ENV=development

# MongoDB connection string. The database name in the path is the one used.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/levitron

# Optional override for the database name. Defaults to the name in the URI.
MONGO_DB=

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
