# ---------------------------------------------------------------------------
# Levitron — repository-wide ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Caches
.cache/
.vite/
node_modules/.vite/
.eslintcache
.parcel-cache/

# Environment — never commit real secrets.
# Keep .env.example, which documents the variables without holding values.
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Operating system
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Local agent/tooling state
.commandcode/

# Misc
*.local
*.pid
*.seed
